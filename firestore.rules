rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function ownerCreate(uid) {
      return signedIn(uid) && request.resource.data.ownerId == uid;
    }

    function ownerUpdate(uid) {
      return signedIn(uid)
        && resource.data.ownerId == uid
        && request.resource.data.ownerId == uid;
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly([
        'cards', 'updatedAt', 'ownerId', 'schemaVersion'
        ])
        && request.resource.data.cards is map
        && request.resource.data.updatedAt is string
        && request.resource.data.schemaVersion == 4;
    }

    function validStats() {
      return request.resource.data.keys().hasOnly([
        'totalMemoryReviews', 'correctMemoryReviews', 'totalQuestionReviews',
        'correctQuestionReviews', 'streakDays', 'longestStreak', 'xp', 'level',
        'lastStudyDate', 'dailyWordGoal', 'dailyQuestionGoal',
        'todayMemoryReviews', 'todayMemoryCorrectReviews',
        'todayQuestionReviews', 'todayQuestionCorrectReviews', 'questionStats',
        'questionStatsBySense',
        'dailyHistory',
        'updatedAt', 'ownerId', 'schemaVersion'
      ])
        && request.resource.data.totalMemoryReviews is number
        && request.resource.data.correctMemoryReviews is number
        && request.resource.data.totalQuestionReviews is number
        && request.resource.data.correctQuestionReviews is number
        && request.resource.data.streakDays is number
        && request.resource.data.longestStreak is number
        && request.resource.data.xp is number
        && request.resource.data.level is number
        && request.resource.data.lastStudyDate is string
        && request.resource.data.dailyWordGoal is number
        && request.resource.data.dailyQuestionGoal is number
        && request.resource.data.todayMemoryReviews is number
        && request.resource.data.todayMemoryCorrectReviews is number
        && request.resource.data.todayQuestionReviews is number
        && request.resource.data.todayQuestionCorrectReviews is number
        && request.resource.data.questionStats is map
        && request.resource.data.questionStatsBySense is map
        && request.resource.data.dailyHistory is map
        && request.resource.data.updatedAt is string
        && request.resource.data.schemaVersion == 4;
    }

    function validSectionItems() {
      // Firestore Rules cannot iterate through maps nested in arbitrary lists.
      // Canonical item schemas are validated before writes by the client parser.
      return request.resource.data.section in ['words', 'sets', 'memberships', 'folders', 'questions']
        && request.resource.data.items is list;
    }

    function validLibraryChunk(chunkId) {
      return request.resource.data.keys().hasOnly([
        'ownerId', 'schemaVersion', 'chunkId', 'updatedAt', 'checksum', 'section', 'items'
      ])
        && request.resource.data.ownerId is string
        && request.resource.data.schemaVersion == 5
        && request.resource.data.chunkId == chunkId
        && request.resource.data.chunkId.matches('chunk-[a-f0-9]{8}')
        && request.resource.data.updatedAt is string
        && request.resource.data.checksum is string
        && request.resource.data.section in ['words', 'sets', 'memberships', 'folders', 'questions']
        && request.resource.data.items is list
        && validSectionItems();
    }

    function validLibraryManifest() {
      return request.resource.data.keys().hasOnly([
        'ownerId', 'schemaVersion', 'documentType', 'updatedAt', 'revision', 'chunks', 'manifestParts'
      ])
        && request.resource.data.ownerId is string
        && request.resource.data.schemaVersion == 5
        && request.resource.data.documentType == 'library-manifest'
        && request.resource.data.updatedAt is string
        && request.resource.data.revision is string
        && request.resource.data.chunks is map
        && (!request.resource.data.keys().hasAny(['manifestParts']) || request.resource.data.manifestParts is map);
    }

    function validLibraryManifestPart(partId) {
      return request.resource.data.keys().hasOnly([
        'ownerId', 'schemaVersion', 'documentType', 'partId', 'updatedAt', 'checksum', 'chunks'
      ])
        && request.resource.data.ownerId is string
        && request.resource.data.schemaVersion == 5
        && request.resource.data.documentType == 'library-manifest-part'
        && request.resource.data.partId == partId
        && request.resource.data.partId.matches('manifest-part-[0-9]{4}')
        && request.resource.data.updatedAt is string
        && request.resource.data.checksum is string
        && request.resource.data.chunks is map;
    }

    function validLibraryDocument(documentId) {
      return validLibraryChunk(documentId) || validLibraryManifestPart(documentId);
    }

    function manifestDoesNotReference(uid, documentId) {
      return !exists(/databases/$(database)/documents/users/$(uid)/library/manifest)
        || (
          (!get(/databases/$(database)/documents/users/$(uid)/library/manifest).data.keys().hasAny(['chunks'])
            || !get(/databases/$(database)/documents/users/$(uid)/library/manifest).data.chunks.keys().hasAny([documentId]))
          && (!get(/databases/$(database)/documents/users/$(uid)/library/manifest).data.keys().hasAny(['manifestParts'])
            || !get(/databases/$(database)/documents/users/$(uid)/library/manifest).data.manifestParts.keys().hasAny([documentId]))
        );
    }

    match /users/{uid} {
      allow read, delete: if signedIn(uid);
      allow create, update: if signedIn(uid) && request.resource.data.ownerId == uid;

      match /library/manifest {
        allow read: if signedIn(uid);
        allow create: if ownerCreate(uid) && validLibraryManifest();
        allow update: if ownerUpdate(uid) && validLibraryManifest();
        allow delete: if signedIn(uid) && resource.data.ownerId == uid;
      }

      match /library/{chunkId} {
        allow read: if signedIn(uid);
        allow create: if ownerCreate(uid) && validLibraryDocument(chunkId);
        // v5 chunks and manifest parts are immutable. Replaying an identical
        // write is harmless, but changing a published document is not.
        allow update: if ownerUpdate(uid) && validLibraryDocument(chunkId) && request.resource.data == resource.data;
        allow delete: if signedIn(uid) && resource.data.ownerId == uid && manifestDoesNotReference(uid, chunkId);
      }

      match /libraryLocks/{lockId} {
        allow read: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && lockId == 'v5-write'
          && request.resource.data.keys().hasOnly(['ownerId', 'schemaVersion', 'token', 'expiresAt'])
          && request.resource.data.ownerId == uid
          && request.resource.data.schemaVersion == 5
          && request.resource.data.token is string
          && request.resource.data.expiresAt is number;
        allow delete: if signedIn(uid) && lockId == 'v5-write' && resource.data.ownerId == uid;
      }

      match /progress/global {
        allow read: if signedIn(uid);
        allow create, update: if ownerCreate(uid) && validProgress();
        allow delete: if signedIn(uid) && resource.data.ownerId == uid;
      }

      match /stats/summary {
        allow read: if signedIn(uid);
        allow create, update: if ownerCreate(uid) && validStats();
        allow delete: if signedIn(uid) && resource.data.ownerId == uid;
      }

      match /settings/ai {
        allow read: if signedIn(uid);
        allow create, update: if signedIn(uid)
          && request.resource.data.keys().hasOnly([
            'enabled', 'provider', 'baseUrl', 'model', 'batchSize',
            'updatedAt', 'ownerId', 'schemaVersion'
          ])
          && request.resource.data.ownerId == uid
          && request.resource.data.enabled is bool
          && request.resource.data.provider in ['openai', 'anthropic', 'google', 'custom']
          && request.resource.data.baseUrl is string
          && request.resource.data.model is string
          && request.resource.data.batchSize is number
          && request.resource.data.updatedAt is string
          && request.resource.data.schemaVersion == 4;
        allow delete: if signedIn(uid) && resource.data.ownerId == uid;
      }

    }
  }
}
