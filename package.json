{
  "name": "lexiro-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests-next scripts",
    "test": "vitest run",
    "build": "esbuild src/index.ts src/response-stream.ts --bundle --platform=browser --format=esm --outdir=dist",
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "benchmark:stream": "node scripts/benchmark-stream.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.2",
    "gpt-tokenizer": "^4.0.0",
    "miniflare": "^5.20260911.0-alpha",
    "oxlint": "^1.41.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "@lexiro/ai-contract": "file:vendor/lexiro-ai-contract-1.8.0.tgz",
    "jose": "^6.2.12",
    "zod": "^4.6.2"
  }
}
