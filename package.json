    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "firebase": "^12.17.0",
    "idb-keyval": "^6.2.4",
    "lucide-vue-next": "^1.0.0",
    "motion-v": "^2.3.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "ts-fsrs": "^5.4.1",
    "vite": "^8.0.10",
