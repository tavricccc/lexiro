# Firebase Web App configuration
# Optional locally; GitHub Actions sets /lexiro/ for GitHub Pages.
VITE_BASE_PATH=/
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key
# Production enables App Check when a site key is present. For local enforcement, set this to true and use a registered debug token.
VITE_FIREBASE_APPCHECK_ENABLED=false
# Keep this only in a local .env file. Register the generated token in Firebase Console > App Check.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Optional local emulator switch; only used by `npm run dev`.
VITE_FIREBASE_EMULATOR_ENABLED=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
