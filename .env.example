# Firebase Web App configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key
# Production enables App Check when a site key is present. For local enforcement, set this to true and use a registered debug token.
NEXT_PUBLIC_FIREBASE_APPCHECK_ENABLED=false
# Keep this only in a local .env file. Register the generated token in Firebase Console > App Check.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Optional local emulator switch; only used by `npm run dev`.
NEXT_PUBLIC_FIREBASE_EMULATOR_ENABLED=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id
