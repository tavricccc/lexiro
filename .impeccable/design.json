      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"教材\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">單字</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">題目</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">工具</button></div>",
      "css": ".ds-tabs{display:flex;gap:2px;padding:3px;border-radius:var(--radius-control);background:var(--surface-inset)}.ds-tab{flex:1;min-width:0;min-height:3rem;border:0;border-radius:var(--radius-segment);background:transparent;color:var(--muted-foreground);font-size:.9375rem;font-family:var(--font-sans);font-weight:500;}.ds-tab[aria-selected=\"true\"]{background:var(--card);color:var(--foreground);box-shadow:var(--shadow-control)}.ds-tab:hover{color:var(--foreground)}.ds-tab:focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
