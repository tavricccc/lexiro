      "html": "<nav class=\"ds-nav\" aria-label=\"主要導覽\"><a href=\"#today\" aria-current=\"page\">今天</a><a href=\"#library\">我的單字</a><a href=\"#progress\">進度</a><a href=\"#me\">我的</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;height:3.875rem;padding:0 .75rem;border-radius:9999px;background:var(--card);box-shadow:var(--shadow-floating);font-family:var(--font-sans);font-weight:500;}.ds-nav a{display:flex;flex:1;align-items:center;justify-content:center;min-height:3rem;border-radius:9999px;font-size:.6875rem;color:var(--muted-foreground);text-decoration:none}.ds-nav a[aria-current]{background:var(--brand-100);color:var(--brand-700);box-shadow:var(--shadow-control)}.ds-nav a:hover{background:var(--surface-hover);color:var(--foreground)}.ds-nav a:focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
