{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@lexiro/contract": ["./packages/contract/src/index.ts"],
      "design-kit": ["./packages/design-kit/src/index.ts"]
    },
    "types": ["vite/client", "@serwist/vite/typings"]
  },
  "include": ["src", "tests", "packages/contract/src", "packages/design-kit/src", "vite.config.ts"]
}
