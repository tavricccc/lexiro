{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/types": [
        "./src/types/index.ts"
      ],
      "@/constants": [
        "./src/constants/index.ts"
      ],
      "@/constants/*": [
        "./src/constants/*"
      ],
      "@/generated/*": [
        "./src/generated/*"
      ],
      "@/lib/*": [
        "./lib/*",
        "./src/lib/*"
      ],
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "vite/client",
      "@serwist/vite/typings"
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "stores/**/*.ts",
    "src/**/*.ts",
    "tests-next/**/*.ts",
    "vite.config.ts",
    "vitest.next.config.ts"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "dist",
    "dev-dist"
  ]
}
